---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | AI Models, Edge Inference & Agricultural Automation`}
			description={SITE_DESCRIPTION}
			image="/og-image.png"
			type="website"
		/>
		<style>
			.hero {
				padding: 1rem 0 2rem 0;
				border-bottom: 1px solid var(--border);
				margin-bottom: 2.5rem;
			}

			.hero-title {
				font-size: 2.4rem;
				letter-spacing: -0.02em;
				margin-bottom: 0.5rem;
				color: var(--heading);
				text-shadow: var(--text-glow-heading);
			}

			.hero-subtitle {
				font-family: var(--font-mono);
				color: var(--accent);
				font-size: 0.95rem;
				text-shadow: var(--text-glow-accent);
			}

			section {
				margin-bottom: 3rem;
			}

			.summary-lead {
				font-size: 1.1rem;
				line-height: 1.7;
				color: var(--heading);
			}

			.demo-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1.25rem;
			}

			.demo-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				width: 100%;
				background: var(--card-bg);
				border: 1px solid var(--border);
				border-radius: 10px;
				padding: 1.25rem;
				text-decoration: none;
				transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
			}

			.demo-box:hover {
				border-color: var(--accent);
				transform: translateY(-4px);
				box-shadow: 0 8px 24px rgba(79, 128, 255, 0.25);
				text-decoration: none;
			}

			.demo-icon-frame {
				width: 100%;
				aspect-ratio: 16 / 10;
				border-radius: 6px;
				overflow: hidden;
				border: 1px solid var(--border);
				background: var(--code-bg);
			}

			.demo-icon {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.3s ease;
			}

			.demo-box:hover .demo-icon {
				transform: scale(1.04);
			}

			.demo-name {
				margin-top: 1rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-family: var(--font-mono);
				font-size: 1.05rem;
				font-weight: 600;
				color: var(--heading);
				transition: color 0.15s ease;
			}

			.demo-box:hover .demo-name {
				color: var(--accent);
			}

			.demo-arrow {
				color: var(--accent);
				transition: transform 0.2s ease;
			}

			.demo-box:hover .demo-arrow {
				transform: translateX(3px);
			}

			@media (max-width: 600px) {
				.demo-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body id="top">
		<Header />
		<main>
			<div class="hero">
				<h1 class="hero-title">Samuel L. Meyers</h1>
				<div class="hero-subtitle">Software Engineer // AI Models, Edge Inference &amp; Agricultural Automation</div>
			</div>

			<section class="summary-section">
				<h2>Summary</h2>
				<p class="summary-lead">
					Software Engineer based in Springfield, MO, actively pursuing a Bachelor of Science in Artificial Intelligence. Dedicated to developing efficient, lightweight AI models and robust edge-computing systems engineered specifically for agricultural automation.
				</p>
				<p>
					Specializing in low-level runtimes, resource-constrained model deployment, and real-time computer vision that operate reliably in demanding field conditions without depending on intermittent cloud infrastructure.
				</p>
			</section>

			<section class="demo-section">
				<h2>Interactive Demos</h2>
				<div class="demo-grid">
					<a
						href="https://samsoupsauce.github.io/card-engine/"
						target="_blank"
						rel="noopener"
						class="demo-box"
						title="Launch Card Game Engine Live Demo"
					>
						<div class="demo-icon-frame">
							<img src="/card-game.svg" alt="Card Game Engine" class="demo-icon" width="800" height="500" />
						</div>
						<div class="demo-name">
							<span>Card Game Engine</span>
							<span class="demo-arrow">&rarr;</span>
						</div>
					</a>
					<a
						href="https://samsoupsauce.github.io/undoku/"
						target="_blank"
						rel="noopener"
						class="demo-box"
						title="Launch Undoku Live Demo"
					>
						<div class="demo-icon-frame">
							<img src="/undoku.svg" alt="Undoku" class="demo-icon" width="800" height="500" />
						</div>
						<div class="demo-name">
							<span>Undoku</span>
							<span class="demo-arrow">&rarr;</span>
						</div>
					</a>
					<a
						href="https://samsoupsauce.github.io/crunch/"
						target="_blank"
						rel="noopener"
						class="demo-box"
						title="Launch Crunch Live Demo"
					>
						<div class="demo-icon-frame">
							<img src="/crunch.svg" alt="Crunch" class="demo-icon" width="800" height="500" />
						</div>
						<div class="demo-name">
							<span>Crunch</span>
							<span class="demo-arrow">&rarr;</span>
						</div>
					</a>
				</div>
			</section>

			<section>
				<h2>Core Focus &amp; Objectives</h2>
				<p>
					Advancing practical machine learning where hardware constraints and field conditions demand extreme compute efficiency:
				</p>
				<div class="grid">
					<div class="card">
						<h3>Agricultural Automation</h3>
						<p>Engineering autonomous vision models and real-time decision algorithms for field operations, precision crop monitoring, weed detection, and robotic guidance.</p>
					</div>
					<div class="card">
						<h3>Efficient AI Architectures</h3>
						<p>Researching model quantization, pruning, and streamlined neural network topologies designed to deliver high inference throughput on edge TPUs and low-power microcomputers.</p>
					</div>
					<div class="card">
						<h3>Resilient Edge Systems</h3>
						<p>Designing self-contained, deterministic software runtimes and sensor pipelines capable of sustained autonomous execution under harsh, disconnected field environments.</p>
					</div>
				</div>
			</section>

			<section>
				<h2>Architecture Ethos</h2>
				<blockquote>
					"Keep the runtime local, optimize model efficiency at the edge, and eliminate brittle cloud dependencies. If an agricultural system cannot run deterministic, low-latency inference on local hardware in the field, it is not fit for production."
				</blockquote>
			</section>

			<section>
				<h2>System Telemetry</h2>
				<div class="status-box">
					<div class="status-line">
						<span class="label">NODE_ENV:</span>
						<span class="val">ACTIVE</span>
					</div>
					<div class="status-line">
						<span class="label">LOCATION:</span>
						<span class="val">Springfield, MO</span>
					</div>
					<div class="status-line">
						<span class="label">ACADEMIC_STATUS:</span>
						<span class="val">PURSUING_BS_IN_ARTIFICIAL_INTELLIGENCE</span>
					</div>
					<div class="status-line">
						<span class="label">PRIMARY_FOCUS:</span>
						<span class="val">EFFICIENT_AI_FOR_AGRICULTURAL_AUTOMATION</span>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
