---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('announcements')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Announcements | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-header {
				margin-bottom: 2.5rem;
				border-bottom: 1px solid var(--border);
				padding-bottom: 1.5rem;
			}

			.page-header h1 {
				margin-bottom: 0.5rem;
			}

			.page-header p {
				color: var(--text-muted);
				font-size: 1rem;
				margin: 0;
			}

			.post-list {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
				gap: 1.5rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.post-item {
				background: var(--card-bg);
				border: 1px solid var(--border);
				border-radius: 8px;
				overflow: hidden;
				transition: border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
			}

			.post-item:hover {
				border-color: var(--border-hover);
				transform: translateY(-3px);
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
			}

			.post-link {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
				color: inherit;
			}

			.post-link:hover {
				text-decoration: none;
			}

			.image-wrapper {
				width: 100%;
				max-height: 200px;
				overflow: hidden;
				border-bottom: 1px solid var(--border);
				background: var(--code-bg);
			}

			.image-wrapper img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				border: none;
				transition: transform 0.3s ease;
			}

			.post-item:hover .image-wrapper img {
				transform: scale(1.03);
			}

			.post-content {
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				flex: 1;
			}

			.post-title {
				color: var(--heading);
				font-size: 1.2rem;
				margin: 0 0 0.5rem 0;
				font-weight: 600;
				transition: color 0.15s ease;
			}

			.post-item:hover .post-title {
				color: var(--accent);
			}

			.post-description {
				font-size: 0.9rem;
				color: var(--text-muted);
				margin-bottom: 1rem;
				line-height: 1.5;
				flex: 1;
			}

			.post-date {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--accent);
				margin-top: auto;
			}

			.empty-state {
				background: var(--card-bg);
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 3rem 1.5rem;
				text-align: center;
			}

			.empty-state p {
				color: var(--text-muted);
				font-family: var(--font-mono);
				font-size: 0.95rem;
				margin: 0;
			}

			@media (max-width: 600px) {
				.post-list {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body id="top">
		<Header />
		<main>
			<div class="page-header">
				<h1>Announcements</h1>
				<p>Updates, project releases, and technical notes from Samuel L. Meyers.</p>
			</div>

			<section>
				{
					posts.length > 0 ? (
						<ul class="post-list">
							{posts.map((post) => (
								<li class="post-item">
									<a href={`/announcements/${post.id}/`} class="post-link">
										{post.data.heroImage ? (
											<div class="image-wrapper">
												<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
											</div>
										) : post.data.image?.url ? (
											<div class="image-wrapper">
												<img src={post.data.image.url} alt={post.data.image.alt || post.data.title} width={720} height={360} loading="lazy" decoding="async" />
											</div>
										) : null}
										<div class="post-content">
											<h2 class="post-title">{post.data.title}</h2>
											<p class="post-description">{post.data.description}</p>
											<div class="post-date">
												<FormattedDate date={post.data.pubDate} />
											</div>
										</div>
									</a>
								</li>
							))}
						</ul>
					) : (
						<div class="empty-state">
							<p>No announcements yet. New technical updates and project releases will be published here.</p>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
