---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects & Open Source Systems | ${SITE_TITLE}`}
			description="Open-source software, luxury casino card game engine, Sudoku cognitive solver, procedural 3D games, and systems by Samuel L. Meyers."
			image="/og-image.png"
			type="website"
			keywords={["Card Game Engine", "Undoku", "Dim33nsi0n", "Crunch", "Three.js", "Web Audio API", "Open Source"]}
		/>
		<style>
			.page-header {
				margin-bottom: 2.5rem;
				border-bottom: 1px solid var(--border);
				padding-bottom: 1.5rem;
			}

			.page-header h1 {
				margin-bottom: 0.5rem;
			}

			.page-header p {
				color: var(--text-muted);
				font-size: 1rem;
				margin: 0;
			}

			.projects-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
				gap: 1.5rem;
			}

			.project-card {
				background: var(--card-bg);
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
			}

			.project-card:hover {
				border-color: var(--border-hover);
				transform: translateY(-2px);
				box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
			}

			.project-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 0.75rem;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.project-title {
				margin: 0;
				font-size: 1.25rem;
				color: var(--heading);
				font-family: var(--font-mono);
			}

			.project-links {
				display: flex;
				gap: 0.85rem;
				font-family: var(--font-mono);
				font-size: 0.82rem;
			}

			.project-links a {
				color: var(--accent);
				text-decoration: none;
			}

			.project-links a:hover {
				color: var(--accent-hover);
				text-decoration: underline;
			}

			.project-desc {
				font-size: 0.93rem;
				color: var(--text);
				line-height: 1.6;
				margin-bottom: 1.25rem;
			}

			.tag-container {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: auto;
			}

			.tag {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				background: var(--code-bg);
				border: 1px solid var(--border);
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				color: var(--text-muted);
			}

			@media (max-width: 600px) {
				.projects-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body id="top">
		<Header />
		<main>
			<div class="page-header">
				<h1>Projects</h1>
				<p>Select open-source software, game engines, and procedural experiments from local repositories.</p>
			</div>

			<section>
				<div class="projects-grid">
					<!-- Card Game Engine -->
					<div class="project-card">
						<div>
							<div class="project-header">
								<h2 class="project-title">Card Game Engine</h2>
								<div class="project-links">
									<a href="https://samsoupsauce.github.io/card-engine/" target="_blank" rel="noopener">Live Demo &rarr;</a>
									<a href="/announcements/card_game_engine/">Announcement &rarr;</a>
									<a href="https://github.com/SamSoupSauce/card-engine" target="_blank" rel="noopener">GitHub &rarr;</a>
								</div>
							</div>
							<p class="project-desc">
								Authentic, zero-dependency luxury casino card gaming suite (Royale VIP Casino Studio). Features certified Baccarat Punto Banco with international third-card tableau rules, live Macau Bead Plate roadmaps, 8-deck shoe simulation, Vegas Strip Blackjack (split, double down, insurance), procedural SVG cards, and synthesized Web Audio sound effects.
							</p>
						</div>
						<div class="tag-container">
							<span class="tag">Vanilla JS</span>
							<span class="tag">Web Audio API</span>
							<span class="tag">Procedural SVG</span>
							<span class="tag">Tailwind CSS</span>
							<span class="tag">GitHub Pages</span>
						</div>
					</div>

					<!-- Undoku -->
					<div class="project-card">
						<div>
							<div class="project-header">
								<h2 class="project-title">Undoku</h2>
								<div class="project-links">
									<a href="https://samsoupsauce.github.io/undoku/" target="_blank" rel="noopener">Live Demo &amp; Wiki &rarr;</a>
									<a href="/announcements/undoku/">Announcement &rarr;</a>
									<a href="https://github.com/SamSoupSauce/undoku" target="_blank" rel="noopener">GitHub &rarr;</a>
								</div>
							</div>
							<p class="project-desc">
								High-performance Sudoku puzzle generator, cognitive solver, difficulty evaluator, Web Canvas game, and Express.js REST API engine. Generates uniquely solvable boards with deterministic step-by-step logical deduction provenance, candidate elimination density heatmaps, and difficulty trajectory analytics.
							</p>
						</div>
						<div class="tag-container">
							<span class="tag">HTML5 Canvas</span>
							<span class="tag">JavaScript</span>
							<span class="tag">Express.js</span>
							<span class="tag">REST API</span>
							<span class="tag">Astro Starlight</span>
						</div>
					</div>

					<!-- Dim33nsi0n -->
					<div class="project-card">
						<div>
							<div class="project-header">
								<h2 class="project-title">Dim33nsi0n</h2>
								<div class="project-links">
									<a href="https://github.com/SamSoupSauce/d1m33nsi0n" target="_blank" rel="noopener">GitHub &rarr;</a>
								</div>
							</div>
							<p class="project-desc">
								Decentralized, serverless WebRTC peer-to-peer infinite open-world walking simulator MMO. Implements multi-stage procedural geomorphology terrain meshing, extruded 3D Hermite roadbed curves, physical collision sampling, and serverless P2P multiplayer state synchronization.
							</p>
						</div>
						<div class="tag-container">
							<span class="tag">Three.js</span>
							<span class="tag">TypeScript</span>
							<span class="tag">WebRTC / Trystero</span>
							<span class="tag">Cannon-es</span>
							<span class="tag">Procedural Generation</span>
						</div>
					</div>

					<!-- Crunch -->
					<div class="project-card">
						<div>
							<div class="project-header">
								<h2 class="project-title">Crunch</h2>
								<div class="project-links">
									<a href="https://samsoupsauce.github.io/crunch/" target="_blank" rel="noopener">Live Demo &rarr;</a>
									<a href="https://github.com/SamSoupSauce/crunch" target="_blank" rel="noopener">GitHub &rarr;</a>
								</div>
							</div>
							<p class="project-desc">
								Hexagonal 3D turn-based strategy board game of long-form positioning and deception. Built with Three.js on a 61-space hexagonal grid where players maneuver to trap their opponent between rocks to achieve "Crunch".
							</p>
						</div>
						<div class="tag-container">
							<span class="tag">Three.js</span>
							<span class="tag">WebGL</span>
							<span class="tag">JavaScript</span>
							<span class="tag">Game Design</span>
							<span class="tag">GitHub Pages</span>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
