---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.back-link {
				display: inline-flex;
				align-items: center;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				margin-bottom: 1.5rem;
				color: var(--text-muted);
			}

			.back-link:hover {
				color: var(--accent);
			}

			article {
				max-width: 800px;
				margin: 0 auto;
			}

			.hero-image {
				width: 100%;
				max-height: 400px;
				overflow: hidden;
				border-radius: 8px;
				border: 1px solid var(--border);
				margin-bottom: 2rem;
				background: var(--code-bg);
			}

			.hero-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border: none;
				border-radius: 0;
			}

			.post-header {
				margin-bottom: 2.5rem;
				border-bottom: 1px solid var(--border);
				padding-bottom: 1.5rem;
			}

			.post-header h1 {
				font-size: 2.3rem;
				margin-bottom: 0.75rem;
				line-height: 1.25;
			}

			.post-date {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--accent);
				display: flex;
				gap: 1rem;
				align-items: center;
			}

			.last-updated {
				color: var(--text-muted);
				font-style: italic;
			}

			.prose {
				font-size: 1.05rem;
				line-height: 1.7;
			}

			.prose :global(p) {
				margin-bottom: 1.5rem;
			}

			.prose :global(h2) {
				font-size: 1.5rem;
				margin-top: 2.5rem;
				margin-bottom: 1rem;
			}

			.prose :global(h3) {
				font-size: 1.25rem;
				margin-top: 2rem;
				margin-bottom: 0.75rem;
			}

			.prose :global(ul), .prose :global(ol) {
				margin-bottom: 1.5rem;
				padding-left: 1.5rem;
			}

			.prose :global(li) {
				margin-bottom: 0.5rem;
			}
		</style>
	</head>

	<body id="top">
		<Header />
		<main>
			<a href="/blog" class="back-link">&larr; Back to all posts</a>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={title} />
					</div>
				)}
				<header class="post-header">
					<h1>{title}</h1>
					<div class="post-date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="last-updated">
									(Updated <FormattedDate date={updatedDate} />)
								</span>
							)
						}
					</div>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
