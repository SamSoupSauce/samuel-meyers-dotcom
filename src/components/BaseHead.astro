---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	author?: string;
	tags?: string[];
	keywords?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/og-image.png',
	type = 'website',
	pubDate,
	updatedDate,
	author = 'Samuel L. Meyers',
	tags = [],
	keywords = [],
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://samuel-meyers.com';

const resolvedImageSrc = typeof image === 'string'
	? image
	: (image && 'src' in image ? image.src : '/og-image.png');

const imageURL = new URL(resolvedImageSrc, Astro.site || Astro.url).toString();

const defaultKeywords = [
	'Samuel L. Meyers',
	'mrovkill',
	'Artificial Intelligence',
	'Agricultural Automation',
	'Edge Computing',
	'Computer Vision',
	'Embedded AI',
	'Model Quantization',
	'Neural Architectures',
	'Autonomous Systems',
	'Software Engineer',
	'Springfield MO',
];

const allKeywords = Array.from(new Set([...keywords, ...tags, ...defaultKeywords]));

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const jsonLdWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Samuel L. Meyers',
	alternateName: ['mrovkill', 'SamSoupSauce'],
	url: siteUrl,
	description: 'Software Engineer specializing in AI models, edge computing, and agricultural automation.',
	author: {
		'@type': 'Person',
		name: 'Samuel L. Meyers',
		url: siteUrl,
		sameAs: [
			'https://github.com/SamSoupSauce',
		],
	},
};

const jsonLdPerson = isHome
	? {
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: 'Samuel L. Meyers',
			alternateName: 'mrovkill',
			url: siteUrl,
			image: new URL('/og-image.png', Astro.site || Astro.url).toString(),
			sameAs: [
				'https://github.com/SamSoupSauce',
			],
			jobTitle: 'Software Engineer',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Springfield',
				addressRegion: 'MO',
				addressCountry: 'US',
			},
			alumniOf: {
				'@type': 'EducationalOrganization',
				name: 'Artificial Intelligence Studies',
			},
			knowsAbout: [
				'Artificial Intelligence',
				'Edge Computing',
				'Agricultural Automation',
				'Computer Vision',
				'Neural Network Quantization',
				'Embedded Microcontrollers',
				'Deterministic Systems',
			],
		}
	: null;

const jsonLdArticle = type === 'article'
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description: description,
			image: imageURL,
			datePublished: pubDate ? pubDate.toISOString() : undefined,
			dateModified: updatedDate ? updatedDate.toISOString() : (pubDate ? pubDate.toISOString() : undefined),
			mainEntityOfPage: {
				'@type': 'WebPage',
				'@id': canonicalURL.toString(),
			},
			author: {
				'@type': 'Person',
				name: author,
				url: siteUrl,
			},
			publisher: {
				'@type': 'Person',
				name: 'Samuel L. Meyers',
				url: siteUrl,
			},
			keywords: tags.length > 0 ? tags.join(', ') : undefined,
		}
	: null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0d0f12" />
<meta name="color-scheme" content="dark" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Samuel L. Meyers" />
<meta name="application-name" content="Samuel L. Meyers" />

<!-- Favicons & Manifest -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Search Engine Crawlers & Indexing -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="author" content={author} />
<meta name="keywords" content={allKeywords.join(', ')} />

<!-- Fonts Preload & Connection -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
{type === 'article' && pubDate && (
	<meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === 'article' && updatedDate && (
	<meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{type === 'article' && author && (
	<meta property="article:author" content={author} />
)}
{type === 'article' && tags.map((t) => (
	<meta property="article:tag" content={t} />
))}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@SamSoupSauce" />
<meta name="twitter:creator" content="@SamSoupSauce" />
<meta name="twitter:domain" content="samuel-meyers.com" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />
{jsonLdPerson && (
	<script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
)}
{jsonLdArticle && (
	<script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
)}
